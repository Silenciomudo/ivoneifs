# Prompt Atelier — configuração
#
# PRODUÇÃO (só Supabase, sem Netlify):
# 1. config.public.js → supabaseUrl + supabaseAnonKey
# 2. Supabase Dashboard → Edge Functions → Secrets:
#      OPENAI_API_KEY = sk-...
#      OPENAI_MODEL   = gpt-4o-mini
# 3. Deploy functions:
#      supabase link --project-ref zsjmksdkawstrhxkzyls
#      supabase functions deploy openai
#      supabase functions deploy health
#
# LOCAL (opcional):
#   npm run dev  +  .env com OPENAI_API_KEY (fallback Express)

OPENAI_API_KEY=sk-sua-chave-aqui
OPENAI_MODEL=gpt-4o-mini
PORT=3456
